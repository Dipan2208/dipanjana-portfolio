# ─── Environment Variables Template ───────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
#
# For production (Vercel): add these in your Vercel project dashboard under
# Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────────────────────

# Google Analytics 4 Measurement ID
# Get from: GA4 → Admin → Data Streams → your stream → Measurement ID
VITE_GA_ID=G-XXXXXXXXXX

# Formspree Endpoint for Contact Terminal
# Get a free form at https://formspree.io
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
